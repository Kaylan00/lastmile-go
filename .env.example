# DATABASE_URL=postgres://lastmile:lastmile@localhost:5432/tracking?sslmode=disable
# CONSUMER_CONCURRENCY=8
# PUBSUB_MAX_DELIVERY_ATTEMPTS=5
# ETA_SPEED_KMH=20
# ETA_ROUTE_FACTOR=1.3
# ANTHROPIC_API_KEY=            # vazio = mensagem padrão na tentativa falha
# LLM_MODEL=claude-opus-5-5
# LLM_TIMEOUT=3s
