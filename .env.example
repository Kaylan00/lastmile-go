# Copie para .env só se for rodar os serviços fora do docker-compose.
# Nunca coloque chave de verdade neste arquivo (ele vai para o Git).

# --- os dois serviços ---
GCP_PROJECT=lastmile-local
PUBSUB_EMULATOR_HOST=localhost:8085   # apague para usar o Pub/Sub de verdade
PUBSUB_SETUP=true                     # cria tópicos/assinaturas na subida (emulador)
LOG_LEVEL=info

# --- dispatch-service ---
# PORT=8080
# DATABASE_URL=postgres://lastmile:lastmile@localhost:5432/dispatch?sslmode=disable
# WORKERS=4
# DB_MAX_CONNS=10

# --- tracking-service ---
